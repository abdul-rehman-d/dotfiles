{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:9b-opencode",
  "autoupdate": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "name": "ollama",
        "baseURL": "http://127.0.0.1:11434/v1",
      },
      "models": {
        "qwen3.5:9b-opencode": {
          "name": "Qwen 3.5 9B (64K)",
          "options": {
            "reasoningEffort": "none",
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
            },
          },
          "limit": {
            "context": 65536,
            "output": 8192,
          },
        },
      },
    },
  },
  "permission": {
    "git push": "ask",
    "git commit": "ask",
    "git reset": "ask",
    "git merge": "ask",
    "git rebase": "ask",
  },
}
